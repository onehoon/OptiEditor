<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="OptiEditor.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OptiEditor.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="OptiEditor"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="OptiEditor" />
        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="240" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" Loaded="Navigation_Loaded" SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="Games" IsSelected="True"><NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon><TextBlock Text="Games" VerticalAlignment="Center" /></NavigationViewItem>
                <NavigationViewItem Tag="Presets"><NavigationViewItem.Icon><SymbolIcon Symbol="Favorite" /></NavigationViewItem.Icon><TextBlock Text="Presets" VerticalAlignment="Center" /></NavigationViewItem>
                <NavigationViewItem Tag="OptiScalerUpdate"><NavigationViewItem.Icon><SymbolIcon Symbol="Sync" /></NavigationViewItem.Icon><TextBlock Text="OptiScaler Update" VerticalAlignment="Center" /></NavigationViewItem>
                <NavigationViewItem Tag="Folders"><NavigationViewItem.Icon><SymbolIcon Symbol="Folder" /></NavigationViewItem.Icon><TextBlock Text="Folders" VerticalAlignment="Center" /></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="Settings"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon><TextBlock Text="Settings" VerticalAlignment="Center" /></NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="RootFrame" />
        </NavigationView>
    </Grid>
</Window>
