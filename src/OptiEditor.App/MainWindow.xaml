<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="OptiEditor.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OptiEditor.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="OptiEditor"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="OptiEditor">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Games" Tag="Games" Icon="Game" IsSelected="True" />
                <NavigationViewItem Content="Presets" Tag="Presets" Icon="Favorite" />
                <NavigationViewItem Content="OptiScaler Update" Tag="OptiScalerUpdate" Icon="Sync" />
                <NavigationViewItem Content="Folders" Tag="Folders" Icon="Folder" />
                <NavigationViewItem Content="Settings" Tag="Settings" Icon="Setting" />
            </NavigationView.MenuItems>
            <Frame x:Name="RootFrame" />
        </NavigationView>
    </Grid>
</Window>
