<Page x:Class="OptiEditor.App.Views.GamesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:OptiEditor.Core.Models">
  <Grid Padding="24" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="Games" Style="{StaticResource TitleTextBlockStyle}"/><Button Content="Rescan" Click="Rescan_Click" IsEnabled="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BooleanNegationConverter}}"/><Button Content="Cancel" Click="Cancel_Click" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}"/><ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Width="24" Height="24"/></StackPanel>
    <StackPanel Grid.Row="1" Spacing="4"><TextBox Header="Search" PlaceholderText="Search games or folders" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{x:Bind ViewModel.InstallationCountText, Mode=OneWay}"/><TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"/><TextBlock Text="{x:Bind ViewModel.LastScanText, Mode=OneWay}"/></StackPanel>
    <Grid Grid.Row="2"><ListView ItemsSource="{x:Bind ViewModel.Installations, Mode=OneWay}" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="models:OptiInstallation"><Border Padding="16" Margin="0,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"><StackPanel Spacing="4"><TextBlock Text="{x:Bind GameDisplayName}" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Text="{x:Bind GameExeName}"/><TextBlock Text="{x:Bind ProductVersion}"/><TextBlock><Run Text="Proxy: "/><Run Text="{x:Bind OptiBinaryFileName}"/></TextBlock><TextBlock Text="{x:Bind InstallDirectory}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Open Folder" Click="OpenFolder_Click" Tag="{x:Bind InstallDirectory}"/><Button Content="Copy Path" Click="CopyPath_Click" Tag="{x:Bind IniPath}"/></StackPanel></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView><TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
  </Grid>
</Page>
