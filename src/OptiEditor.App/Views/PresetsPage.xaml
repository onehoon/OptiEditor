<Page x:Class="OptiEditor.App.Views.PresetsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:presets="using:OptiEditor.Core.Presets">
    <Grid Padding="24">
        <Grid x:Name="PresetList">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="Presets" Style="{StaticResource TitleTextBlockStyle}"/><Button Content="Create 0.9 Preset" Tag="V09" Click="Create_Click"/><Button Content="Create 0.10 Preset" Tag="V10" Click="Create_Click"/></StackPanel>
                <StackPanel Grid.Row="1" Spacing="4"><TextBox PlaceholderText="Search presets" Height="36" Padding="12,4,12,0" VerticalContentAlignment="Center" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"/><TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"/></StackPanel>
                <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.FilteredPresets, Mode=OneWay}" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="presets:PresetDefinition"><Border Padding="12" Margin="0,4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6"><StackPanel Spacing="4"><TextBlock Text="{x:Bind Name}" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Text="{x:Bind Description}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Family}"/><TextBlock><Run Text="Included settings: "/><Run Text="{x:Bind Entries.Count}"/></TextBlock><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Apply to Game" Click="Apply_Click" Tag="{x:Bind}"/><Button Content="Duplicate" Click="Duplicate_Click" Tag="{x:Bind}"/><Button Content="Edit" Click="Edit_Click" Tag="{x:Bind}"/><Button Content="Delete" Click="Delete_Click" Tag="{x:Bind}"/></StackPanel></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView>
            </Grid>
        </Grid>

        <Grid x:Name="PresetEditor" Visibility="Collapsed" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="6"><TextBlock x:Name="EditorTitle" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock x:Name="EditorFamily" Opacity="0.7"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Save" Click="SavePreset_Click"/><Button Content="Cancel" Click="CancelPresetEdit_Click"/></StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Spacing="8"><TextBox x:Name="PresetNameBox" Header="Name"/><TextBox x:Name="PresetDescriptionBox" Header="Description"/><TextBox x:Name="PresetSettingSearchBox" PlaceholderText="Search settings or sections" Height="36" Padding="12,4,12,0" VerticalContentAlignment="Center" TextChanged="PresetSettingSearchBox_TextChanged"/></StackPanel>
            <ScrollViewer Grid.Row="2"><StackPanel x:Name="PresetSectionsPanel" Spacing="8"/></ScrollViewer>
        </Grid>
    </Grid>
</Page>
