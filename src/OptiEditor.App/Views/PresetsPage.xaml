<Page x:Class="OptiEditor.App.Views.PresetsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:OptiEditor.App.Views"
      xmlns:vm="using:OptiEditor.App.ViewModels">
    <Page.Resources>
        <DataTemplate x:Key="ApplyGameCardTemplate" x:DataType="local:ApplyGameItem">
            <Border
                MinWidth="0"
                Padding="12"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            Text="{x:Bind GameDisplayName}"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis"/>
                        <TextBlock
                            Text="{x:Bind GameExeName}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <CheckBox
                        Grid.Column="1"
                        Width="20"
                        Height="20"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                        Click="ApplyGameCheckBox_Click"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24">
        <Grid x:Name="PresetList">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Presets" Style="{StaticResource TitleTextBlockStyle}"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"><Button Content="Create 0.9 Preset" Tag="V09" Click="Create_Click"/><Button Content="Create 0.10 Preset" Tag="V10" Click="Create_Click"/></StackPanel></Grid>
                <StackPanel Grid.Row="1" Spacing="4"><TextBox PlaceholderText="Search presets" Height="36" Padding="12,4,12,0" VerticalContentAlignment="Center" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"/><TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"/></StackPanel>
                <ScrollViewer Grid.Row="2" HorizontalScrollMode="Disabled"><ItemsControl ItemsSource="{x:Bind ViewModel.FilteredPresets, Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PresetCardItem"><Border Padding="12" Margin="0,4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"><StackPanel Spacing="4"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind NameWithVersion}" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Edit" Click="Edit_Click" Tag="{x:Bind Preset}"/><Button Content="Delete" Click="Delete_Click" Tag="{x:Bind Preset}"/><Button Content="Apply to Games" Click="ApplyToGames_Click" Tag="{x:Bind Preset}"/></StackPanel></Grid><TextBlock Text="{x:Bind Description}" TextWrapping="Wrap"/><ItemsControl ItemsSource="{x:Bind SettingLines}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
            </Grid>
        </Grid>

        <Grid x:Name="ApplyPresetPage" Visibility="Collapsed" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ApplyTitle" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock x:Name="ApplyVersion" Opacity="0.7"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button x:Name="ApplySelectedButton" Content="Apply Selected" Click="ApplySelected_Click"/><Button x:Name="BackFromApplyButton" Content="Back" Click="BackFromApply_Click"/></StackPanel></Grid>
            <Grid Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox x:Name="ApplyAllCheckBox" Content="All" Click="ApplyAll_Click"/><TextBox x:Name="ApplySearchBox" Grid.Column="1" PlaceholderText="Search games" TextChanged="ApplySearch_TextChanged" Height="36" Padding="12,2,12,0" VerticalContentAlignment="Center"/></Grid>
            <ScrollViewer Grid.Row="2" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <ItemsRepeater
                    x:Name="ApplyGamesRepeater"
                    ItemsSource="{x:Bind ApplyGames, Mode=OneWay}"
                    ItemTemplate="{StaticResource ApplyGameCardTemplate}"
                    HorizontalAlignment="Stretch">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            Orientation="Horizontal"
                            MinItemWidth="420"
                            MinColumnSpacing="12"
                            MinRowSpacing="12"
                            ItemsStretch="Fill"
                            ItemsJustification="Start"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="PresetEditor" Visibility="Collapsed" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="6"><TextBlock x:Name="EditorTitle" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock x:Name="EditorFamily" Opacity="0.7"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Save" Click="SavePreset_Click"/><Button Content="Cancel" Click="CancelPresetEdit_Click"/></StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Spacing="8">
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Name" VerticalAlignment="Center"/><TextBox x:Name="PresetNameBox" Grid.Column="1" Height="36" Padding="12,2,12,2" VerticalContentAlignment="Center"/></Grid>
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Description" VerticalAlignment="Center"/><TextBox x:Name="PresetDescriptionBox" Grid.Column="1" Height="36" Padding="12,2,12,2" VerticalContentAlignment="Center"/></Grid>
                <TextBox x:Name="PresetSettingSearchBox" PlaceholderText="Search settings" Height="36" Padding="12,2,12,2" VerticalContentAlignment="Center" TextChanged="PresetSettingSearchBox_TextChanged"/>
            </StackPanel>
            <ScrollViewer Grid.Row="2"><StackPanel x:Name="PresetSectionsPanel" Spacing="8"/></ScrollViewer>
        </Grid>
    </Grid>
</Page>
