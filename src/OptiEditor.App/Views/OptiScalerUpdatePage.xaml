<Page x:Name="RootPage" x:Class="OptiEditor.App.Views.OptiScalerUpdatePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:OptiEditor.App.ViewModels" xmlns:models="using:OptiEditor.Core.Models">
  <ScrollViewer><StackPanel Padding="24" Spacing="16">
    <TextBlock Text="OptiScaler Update" Style="{StaticResource TitleTextBlockStyle}"/>
    <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
      <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="8"><TextBlock Text="Source OptiScaler Binary" Style="{StaticResource SubtitleTextBlockStyle}"/>
        <TextBlock Text="{x:Bind ViewModel.SourceDetails, Mode=OneWay}" TextWrapping="Wrap"/>
        <TextBlock Text="{x:Bind ViewModel.SourceError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"/>
      </StackPanel>
        <Button Grid.Column="1" Content="Select Source" Click="SelectSource_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanNegationConverter}}"/>
      </Grid>
    </Border>
    <StackPanel Spacing="8"><TextBlock Text="Version Selection" Style="{StaticResource SubtitleTextBlockStyle}"/>
      <StackPanel Orientation="Horizontal" Spacing="16"><CheckBox Content="OptiScaler 0.9" IsChecked="{x:Bind ViewModel.IsV09Selected, Mode=TwoWay}"/><CheckBox Content="OptiScaler 0.10" IsChecked="{x:Bind ViewModel.IsV10Selected, Mode=TwoWay}"/><CheckBox Content="All" IsChecked="{x:Bind ViewModel.IsAllSelected, Mode=TwoWay}"/></StackPanel>
      <TextBox Header="Search" PlaceholderText="Search installations" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}"/>
      <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"/>
      <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Replace Selected" Click="ReplaceSelected_Click" IsEnabled="{x:Bind ViewModel.CanReplace, Mode=OneWay}"/><Button Content="Cancel" Click="Cancel_Click" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/><ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24"/></StackPanel>
    </StackPanel>
    <ItemsControl ItemsSource="{x:Bind ViewModel.UpdateRows, Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:OptiScalerUpdateRow"><Grid Margin="0,0,0,12" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ContentPresenter Content="{x:Bind First}"><ContentPresenter.ContentTemplate><DataTemplate x:DataType="vm:OptiScalerUpdateItemViewModel"><Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"><StackPanel Spacing="4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Installation.GameDisplayName}" Style="{StaticResource SubtitleTextBlockStyle}"/><CheckBox Grid.Column="1" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind IsSelectionEnabled, Mode=OneWay}" VerticalAlignment="Center"/></Grid><TextBlock Text="{x:Bind Installation.GameExeName}"/><TextBlock><Run Text="{x:Bind Installation.OptiBinaryFileName}"/><Run Text=" ("/><Run Text="{x:Bind Installation.FileVersion}"/><Run Text=")"/></TextBlock><TextBlock Text="{x:Bind Installation.InstallDirectory}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ContentPresenter.ContentTemplate></ContentPresenter><ContentPresenter Grid.Column="1" Content="{x:Bind Second}"><ContentPresenter.ContentTemplate><DataTemplate x:DataType="vm:OptiScalerUpdateItemViewModel"><Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"><StackPanel Spacing="4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Installation.GameDisplayName}" Style="{StaticResource SubtitleTextBlockStyle}"/><CheckBox Grid.Column="1" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind IsSelectionEnabled, Mode=OneWay}" VerticalAlignment="Center"/></Grid><TextBlock Text="{x:Bind Installation.GameExeName}"/><TextBlock><Run Text="{x:Bind Installation.OptiBinaryFileName}"/><Run Text=" ("/><Run Text="{x:Bind Installation.FileVersion}"/><Run Text=")"/></TextBlock><TextBlock Text="{x:Bind Installation.InstallDirectory}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ContentPresenter.ContentTemplate></ContentPresenter></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></ScrollViewer>
</Page>
