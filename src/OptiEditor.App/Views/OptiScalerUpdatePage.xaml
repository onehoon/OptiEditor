<Page x:Name="RootPage" x:Class="OptiEditor.App.Views.OptiScalerUpdatePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:OptiEditor.App.ViewModels" xmlns:models="using:OptiEditor.Core.Models">
  <ScrollViewer><StackPanel Padding="24" Spacing="16">
    <TextBlock Text="OptiScaler Update" Style="{StaticResource TitleTextBlockStyle}"/>
    <Border Padding="20" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
      <StackPanel Spacing="8"><TextBlock Text="Source OptiScaler Binary" Style="{StaticResource SubtitleTextBlockStyle}"/>
        <TextBlock Text="No source file selected"/>
        <TextBlock Text="{x:Bind ViewModel.Source.Path, Mode=OneWay}" TextWrapping="Wrap"/>
        <TextBlock Text="{x:Bind ViewModel.Source.FileVersion, Mode=OneWay}"/>
        <TextBlock Text="{x:Bind ViewModel.Source.ProductVersion, Mode=OneWay}"/>
        <TextBlock Text="{x:Bind ViewModel.Source.FileSize, Mode=OneWay}"/>
        <TextBlock Text="{x:Bind ViewModel.SourceError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"/>
        <Button Content="Select Source" Click="SelectSource_Click" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanNegationConverter}}"/>
      </StackPanel>
    </Border>
    <StackPanel Spacing="8"><TextBlock Text="Bulk Selection" Style="{StaticResource SubtitleTextBlockStyle}"/>
      <StackPanel Orientation="Horizontal" Spacing="16"><CheckBox Content="OptiScaler 0.9" IsChecked="{x:Bind ViewModel.IsV09Selected, Mode=TwoWay}"/><CheckBox Content="OptiScaler 0.10" IsChecked="{x:Bind ViewModel.IsV10Selected, Mode=TwoWay}"/><CheckBox Content="All" IsChecked="{x:Bind ViewModel.IsAllSelected, Mode=TwoWay}"/></StackPanel>
      <TextBox Header="Search" PlaceholderText="Search installations" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}"/>
      <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"/>
      <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Replace Selected" Click="ReplaceSelected_Click" IsEnabled="{x:Bind ViewModel.CanReplace, Mode=OneWay}"/><Button Content="Cancel" Click="Cancel_Click" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/><ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24"/></StackPanel>
    </StackPanel>
    <ListView ItemsSource="{x:Bind ViewModel.FilteredItems, Mode=OneWay}" SelectionMode="None"><ListView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" ItemWidth="360" ItemHeight="170"/></ItemsPanelTemplate></ListView.ItemsPanel><ListView.ItemTemplate><DataTemplate x:DataType="vm:OptiScalerUpdateItemViewModel"><Border Padding="16" Margin="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"><StackPanel Spacing="4"><CheckBox Content="Select" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind IsSelectionEnabled, Mode=OneWay}"/><TextBlock Text="{x:Bind Installation.GameDisplayName}" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Text="{x:Bind Installation.GameExeName}"/><TextBlock><Run Text="Proxy: "/><Run Text="{x:Bind Installation.OptiBinaryFileName}"/><Run Text=" ("/><Run Text="{x:Bind Installation.FileVersion}"/><Run Text=")"/></TextBlock><TextBlock Text="{x:Bind Installation.ProductVersion}"/><TextBlock Text="{x:Bind Installation.InstallDirectory}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView>
  </StackPanel></ScrollViewer>
</Page>
